datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PAID
  PICKED_UP
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  phone       String?
  role        Role
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gearItems gearItem[]    @relation("ProviderGear")
  orders    RentalOrder[] @relation("CustomerOrders")
  reviews   Review[]
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  gearItems gearItem[]
}

model gearItem {
  id          String        @id @default(uuid())
  title       String
  description String
  pricePerDay Float
  brand       String
  stock       Int
  images      String[]      @default([])
  isAvailable Boolean       @default(true)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  providerId  String
  provider    User          @relation("ProviderGear", fields: [providerId], references: [id])
  orders      RentalOrder[]
  reviews     Review[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model RentalOrder {
  id          String      @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  quantity    Int         @default(1)
  totalPrice  Float
  status      OrderStatus @default(PLACED)
  customerId  String
  customer    User        @relation("CustomerOrders", fields: [customerId], references: [id])
  gearItemId  String
  gearItem    gearItem    @relation(fields: [gearItemId], references: [id])
  payments    Payment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String        @unique
  amount        Float
  method        String        @default("STRIPE")
  status        PaymentStatus @default(PENDING)
  rentalOrderId String
  rentalOrder   RentalOrder   @relation(fields: [rentalOrderId], references: [id])
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  gearItemId String
  gearItem   gearItem @relation(fields: [gearItemId], references: [id])
  createdAt  DateTime @default(now())
}